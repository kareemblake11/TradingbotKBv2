import pandas as pd
import numpy as np
import yfinance as yf

from xgboost import XGBClassifier
from sklearn.metrics import classification_report

# ==========================
# SETTINGS
# ==========================

THRESHOLD = 0.75
HOLD_DAYS = 5

TICKERS = [
    "SPY",
    "QQQ",
    "AAPL",
    "MSFT",
    "NVDA",
    "AMD",
    "META",
    "AMZN"
]

# ==========================
# DOWNLOAD BENCHMARKS
# ==========================

print("Downloading benchmark data...")

vix = yf.download(
    "^VIX",
    period="10y",
    auto_adjust=True,
    progress=False
)

spy = yf.download(
    "SPY",
    period="10y",
    auto_adjust=True,
    progress=False
)

vix_close = vix["Close"].squeeze()
spy_close = spy["Close"].squeeze()

spy_return20 = spy_close.pct_change(20)

spy_ema200 = spy_close.ewm(
    span=200,
    adjust=False
).mean()

market_trend = (
    spy_close > spy_ema200
).astype(int)

# ==========================
# BUILD DATASET
# ==========================

all_data = []

for ticker in TICKERS:

    print(f"Processing {ticker}")

    stock = yf.download(
        ticker,
        period="10y",
        auto_adjust=True,
        progress=False
    )

    if stock.empty:
        continue

    df = pd.DataFrame()

    df["Close"] = stock["Close"].squeeze()
    df["Volume"] = stock["Volume"].squeeze()
    df["High"] = stock["High"].squeeze()
    df["Low"] = stock["Low"].squeeze()

    df["Ticker"] = ticker

    # VIX

    df["VIX"] = vix_close.reindex(df.index)
    df["VIX_Change"] = df["VIX"].pct_change()

    # EMA

    df["EMA20"] = df["Close"].ewm(span=20).mean()
    df["EMA50"] = df["Close"].ewm(span=50).mean()
    df["EMA200"] = df["Close"].ewm(span=200).mean()

    df["EMA20_Distance"] = (
        df["Close"] / df["EMA20"] - 1
    )

    df["EMA50_Distance"] = (
        df["Close"] / df["EMA50"] - 1
    )

    df["EMA200_Distance"] = (
        df["Close"] / df["EMA200"] - 1
    )

    # RSI

    delta = df["Close"].diff()

    gain = delta.where(delta > 0, 0)
    loss = -delta.where(delta < 0, 0)

    avg_gain = gain.rolling(14).mean()
    avg_loss = loss.rolling(14).mean()

    rs = avg_gain / avg_loss

    df["RSI"] = (
        100 - (100 / (1 + rs))
    )

    # Volume

    df["VolumeRatio"] = (
        df["Volume"] /
        df["Volume"].rolling(20).mean()
    )

    # Volatility

    df["Volatility"] = (
        df["Close"]
        .pct_change()
        .rolling(20)
        .std()
    )

    # Momentum

    df["Return1"] = df["Close"].pct_change(1)
    df["Return5"] = df["Close"].pct_change(5)
    df["Return20"] = df["Close"].pct_change(20)

    # Relative Strength

    aligned_spy = spy_return20.reindex(df.index)

    df["RelativeStrength"] = (
        df["Return20"] - aligned_spy
    )

    # Market Trend

    df["MarketTrend"] = (
        market_trend.reindex(df.index)
    )

    # Range

    df["HighLowRange"] = (
        (df["High"] - df["Low"])
        / df["Close"]
    )

    # Distance from 52w High

    high52 = (
        df["Close"]
        .rolling(252)
        .max()
    )

    df["Distance52WHigh"] = (
        df["Close"] / high52 - 1
    )

    # VIX Distance

    vix_ema = (
        df["VIX"]
        .ewm(span=20)
        .mean()
    )

    df["VIX_Distance"] = (
        df["VIX"] / vix_ema - 1
    )

    # Target

    df["FutureReturn"] = (
        df["Close"]
        .shift(-HOLD_DAYS)
        / df["Close"]
        - 1
    )

    df["Target"] = (
        df["FutureReturn"] > 0
    ).astype(int)

    df.dropna(inplace=True)

    all_data.append(df)

# ==========================
# COMBINE
# ==========================

df = pd.concat(
    all_data,
    ignore_index=False
)

ticker_map = {
    t: i
    for i, t in enumerate(TICKERS)
}

df["TickerID"] = (
    df["Ticker"]
    .map(ticker_map)
)

# ==========================
# FEATURES
# ==========================

features = [
    "EMA20_Distance",
    "EMA50_Distance",
    "EMA200_Distance",
    "RSI",
    "VolumeRatio",
    "Volatility",
    "Return1",
    "Return5",
    "Return20",
    "VIX",
    "VIX_Change",
    "RelativeStrength",
    "MarketTrend",
    "HighLowRange",
    "Distance52WHigh",
    "VIX_Distance",
    "TickerID"
]

X = df[features]
y = df["Target"]

# ==========================
# SPLIT
# ==========================

split = int(len(df) * 0.8)

X_train = X.iloc[:split]
X_test = X.iloc[split:]

y_train = y.iloc[:split]
y_test = y.iloc[split:]

# ==========================
# MODEL
# ==========================

print("Training model...")

model = XGBClassifier(
    n_estimators=500,
    max_depth=6,
    learning_rate=0.03,
    subsample=0.8,
    colsample_bytree=0.8,
    random_state=42,
    eval_metric="logloss"
)

model.fit(
    X_train,
    y_train
)

# ==========================
# PREDICTIONS
# ==========================

probs = model.predict_proba(X_test)[:, 1]

pred = (
    probs > THRESHOLD
).astype(int)

# ==========================
# REPORT
# ==========================

print("\nClassification Report\n")

print(
    classification_report(
        y_test,
        pred,
        zero_division=0
    )
)

# ==========================
# IMPORTANCE
# ==========================

print("\nFeature Importance\n")

for feature, importance in sorted(
    zip(features, model.feature_importances_),
    key=lambda x: x[1],
    reverse=True
):
    print(
        f"{feature}: {importance:.4f}"
    )

# ==========================
# BACKTEST
# ==========================

future_returns = (
    df.iloc[split:]["FutureReturn"]
    .reset_index(drop=True)
)

trade_returns = []

for signal, future_return in zip(
    pred,
    future_returns
):
    if signal == 1:
        trade_returns.append(
            future_return
        )

print("\nBacktest Results\n")

print(
    "Trades Taken:",
    len(trade_returns)
)

if len(trade_returns):

    trade_returns = np.array(
        trade_returns
    )

    print(
        "Average Return:",
        round(
            trade_returns.mean() * 100,
            2
        ),
        "%"
    )

    print(
        "Win Rate:",
        round(
            (
                trade_returns > 0
            ).mean() * 100,
            2
        ),
        "%"
    )

    gross_profit = (
        trade_returns[
            trade_returns > 0
        ].sum()
    )

    gross_loss = abs(
        trade_returns[
            trade_returns <= 0
        ].sum()
    )

    profit_factor = (
        gross_profit /
        gross_loss
        if gross_loss > 0
        else 999
    )

    print(
        "Profit Factor:",
        round(profit_factor, 2)
    )

# ==========================
# LIVE SIGNALS
# ==========================

print("\nLIVE SIGNALS\n")

for ticker in TICKERS:

    latest = (
        df[df["Ticker"] == ticker]
        .tail(1)
    )

    probability = model.predict_proba(
        latest[features]
    )[0][1]

    signal = (
        "BUY"
        if probability > THRESHOLD
        else "NO TRADE"
    )

    print(
        f"{ticker:<6}"
        f" {probability*100:6.2f}% "
        f"{signal}"
    )

